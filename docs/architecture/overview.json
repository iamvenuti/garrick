  "cards": [
    {
      "dot": "cyan",
      "title": "Ways in",
      "items": [
        "Recordings always become conversations",
        "Mail and files go where they belong: a conversation, a project, or something to read"
      ]
    },
    {
      "dot": "rose",
      "title": "One memory, walled use",
      "items": [
        "Everything is remembered in one place",
        "Declared walls tell the assistant to keep one party's meetings out of another's projects, with limited checks before a commit"
      ]
    },
    {
      "dot": "slate",
      "title": "Tools around it",
      "items": [
        "You talk to your assistant in its desktop app, or in cmux or on your phone; it follows the rules and does the work across everything",
        "Obsidian lets you browse all of it; the status page shows where every thread stands and what needs attention. Both only read, and both are optional, like cmux and the phone"
      ]
    }
