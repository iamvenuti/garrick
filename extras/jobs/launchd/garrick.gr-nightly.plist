<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Garrick's nightly job at 05:15, before the todo sweep. Four steps, each run
  whatever happened in the one before:
  1. Context Nurture's mechanical fixes (a link broken by a rename, a
     deliverable without its date prefix, a thread missing from its hub, a
     status synonym), committed one commit per repository, of the files it
     changed and no other. Wall, attribution and judgment findings wait in
     the day's report for a session.
  2. The effort record, so the Effort view keeps the days whose transcripts
     Claude Code has deleted.
  3. Your own nightly checks, System/jobs/nightly.local, when that file is
     there and executable. Garrick never ships or changes it.
  4. The status page, rebuilt with the flags the Mac app last gave it.
  No assistant is called.
  Copy it to ~/Library/LaunchAgents/ and edit the copy.
  If your workspace is not ~/Garrick, replace each /Users/&lt;you&gt;/Garrick
  with its full path. Then replace every other &lt;you&gt; (written that way
  because this is XML) with your macOS user name; launchd does not expand ~.
  Load it:

    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/garrick.gr-nightly.plist

  Unload with `launchctl bootout gui/$(id -u)/garrick.gr-nightly`.
  Where its notices go (failed, recovered) is the status page's
  Settings › Notifications; GARRICK_NOTIFY or GARRICK_NOTIFY_CMD added to
  EnvironmentVariables override that for this job alone. See
  docs/extras/scheduled-jobs.md for the other variables.
  The digest argument below sends one line, what was fixed and what waits,
  as the Todo summary notice, to wherever Settings › Notifications sends it;
  remove it for none. To nurture one zone or wiki only, add a scope argument
  after it, followed by the path (Zones/Work), and one pair for each other.
  The effort record takes an also argument and a moved argument, each
  followed by a folder, as the status page does; add a pair for each.
  Whatever job.py cannot write to its own log, such as the error from a path
  left wrong, goes to gr-nightly.launchd.log in the jobs' log folder.
  launchd does not create that folder: run the job once by hand first.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>garrick.gr-nightly</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>/Users/&lt;you&gt;/Garrick/System/jobs/job.py</string>
    <string>gr-nightly</string>
    <string>--cwd</string>
    <string>/Users/&lt;you&gt;/Garrick</string>
    <string>--timeout</string>
    <string>3600</string>
    <string>--</string>
    <string>/usr/bin/python3</string>
    <string>/Users/&lt;you&gt;/Garrick/System/jobs/nightly.py</string>
    <string>--workspace</string>
    <string>/Users/&lt;you&gt;/Garrick</string>
    <string>--digest</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>GARRICK_ABOUT</key>
    <string>Each night: applies the checks' mechanical fixes, records effort, runs your nightly.local checks and rebuilds the page.</string>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>
  <key>StandardOutPath</key>
  <string>/Users/&lt;you&gt;/Library/Logs/garrick-jobs/gr-nightly.launchd.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/&lt;you&gt;/Library/Logs/garrick-jobs/gr-nightly.launchd.log</string>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>5</integer>
    <key>Minute</key>
    <integer>15</integer>
  </dict>
</dict>
</plist>
